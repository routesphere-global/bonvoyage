#!/bin/sh
set -eu

if [ "$1" = configure ]; then
    if ! getent passwd bonvoyage >/dev/null; then
        adduser --system --group --no-create-home --home /var/lib/bonvoyage bonvoyage
    fi
    user_entry=$(getent passwd bonvoyage)
    group_entry=$(getent group bonvoyage)
    uid=$(printf '%s\n' "$user_entry" | cut -d: -f3)
    gid=$(printf '%s\n' "$user_entry" | cut -d: -f4)
    group_gid=$(printf '%s\n' "$group_entry" | cut -d: -f3)
    home=$(printf '%s\n' "$user_entry" | cut -d: -f6)
    shell=$(printf '%s\n' "$user_entry" | cut -d: -f7)
    case "$shell" in /usr/sbin/nologin|/bin/false) ;; *) echo "unsupported bonvoyage login identity" >&2; exit 1 ;; esac
    if [ "$uid" -eq 0 ] || [ "$gid" -eq 0 ] || [ "$gid" != "$group_gid" ] || [ "$home" != /var/lib/bonvoyage ]; then
        echo "unsupported bonvoyage service identity" >&2
        exit 1
    fi
    for directory in /etc/bonvoyage /var/lib/bonvoyage; do
        if [ -L "$directory" ] || { [ -e "$directory" ] && [ ! -d "$directory" ]; }; then
            echo "unsafe bonvoyage state directory" >&2
            exit 1
        fi
    done
    if [ ! -e /etc/bonvoyage ]; then install -d -o root -g bonvoyage -m 0750 /etc/bonvoyage; fi
    if [ ! -e /var/lib/bonvoyage ]; then install -d -o bonvoyage -g bonvoyage -m 0750 /var/lib/bonvoyage; fi
    if [ "$(stat -c '%u:%g:%a' /etc/bonvoyage)" != "0:$gid:750" ] || [ "$(stat -c '%u:%g:%a' /var/lib/bonvoyage)" != "$uid:$gid:750" ]; then
        echo "existing bonvoyage state ownership/mode requires operator reconciliation" >&2
        exit 1
    fi
fi

#DEBHELPER#
