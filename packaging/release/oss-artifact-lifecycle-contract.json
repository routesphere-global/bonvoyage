      "id": "gateway-deb-linux-amd64",
      "kind": "debian-package",
      "transition": "package-upgrade-rollback-reactivate",
      "phases": [
        {
          "id": "candidate-fresh-install",
          "required_checks": [
            "package_identity_exact",
            "payload_identity_exact",
            "service_inactive_after_install",
