        },
        {
          "id": "upgrade-from-baseline",
          "required_checks": [
            "baseline_active",
            "candidate_package_installed",
            "service_not_implicitly_restarted",
            "candidate_activated_after_explicit_restart",
            "fixed_route_exact",
            "proxied_route_exact",
            "automatic_restarts_zero"
          ]
        },
        {
          "id": "rollback-to-baseline",
          "required_checks": [
            "baseline_package_restored",
            "service_not_implicitly_restarted",
            "baseline_activated_after_explicit_restart",
            "traffic_restored",
            "automatic_restarts_zero"
          ]
        },
        {
          "id": "candidate-reactivation",
          "required_checks": [
            "candidate_package_restored",
            "candidate_activated_after_explicit_restart",
            "traffic_restored",
            "automatic_restarts_zero"
          ]
        },
        {
          "id": "shutdown-remove",
          "required_checks": [
            "graceful_stop",
            "process_absent",
            "package_absent",
            "package_payload_absent",
            "operator_state_retained"
          ]
        }
      ]
    },
    {
      "id": "gateway-oci-linux-amd64",
      "kind": "oci-image",
      "transition": "container-replacement-rollback-reactivate",
      "phases": [
        {
          "id": "candidate-fresh-start",
          "required_checks": [
            "archive_identity_exact",
            "image_manifest_exact",
            "hardened_runtime_exact",
            "fixed_route_exact",
            "proxied_route_exact",
            "runtime_error_counters_zero"
          ]
        },
        {
          "id": "replace-baseline-with-candidate",
          "required_checks": [
            "baseline_digest_active",
            "candidate_digest_active",
            "old_container_absent",
            "fixed_route_exact",
            "proxied_route_exact"
          ]
        },
        {
          "id": "rollback-to-baseline",
          "required_checks": [
            "candidate_container_absent",
            "baseline_digest_active",
            "traffic_restored"
          ]
        },
        {
          "id": "candidate-reactivation",
          "required_checks": [
            "baseline_container_absent",
            "candidate_digest_active",
            "traffic_restored"
          ]
