{
  "schema_version": 1,
  "classification": "routesphere-bonvoyage-oss-oci-image-contract",
  "artifact": {
    "format": "oci-image-layout-tar",
    "media_type": "application/vnd.oci.image.manifest.v1+json",
    "config_media_type": "application/vnd.oci.image.config.v1+json",
    "layer_media_type": "application/vnd.oci.image.layer.v1.tar+gzip",
    "platform": {
      "architecture": "amd64",
      "os": "linux"
    },
    "manifest_count": 1,
    "layer_count": 1
  },
  "runtime": {
    "user": "65532:65532",
    "working_directory": "/var/lib/bonvoyage",
    "environment": [
      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    ],
    "exposed_ports": [
      "8080/tcp",
      "8443/tcp",
      "9090/tcp",
      "9901/tcp"
    ],
    "entrypoint": [
      "/usr/local/bin/bonvoyage-dataplane"
    ],
    "command": [
      "--snapshot",
      "/etc/bonvoyage/snapshot.pb",
      "--admin-address",
      "0.0.0.0",
      "--metrics-address",
      "0.0.0.0",
      "--runtime-log-transport",
      "stderr-pipe",
      "--smp",
      "1",
      "--memory",
      "256M",
      "--overprovisioned"
    ]
  },
  "rootfs": {
    "required_files": [
      "etc/os-release",
      "etc/ssl/certs/ca-certificates.crt",
      "usr/local/bin/bonvoyage-dataplane",
      "usr/share/bonvoyage/THIRD_PARTY_NOTICES.md",
      "usr/share/bonvoyage/THIRD_PARTY_SOURCE.md",
      "usr/share/bonvoyage/runtime-package-ownership.json",
      "usr/share/licenses/abseil/LICENSE",
      "usr/share/licenses/bonvoyage/LICENSE",
      "usr/share/licenses/c-ares/LICENSE.md",
      "usr/share/licenses/libjwt/LICENSE",
      "usr/share/licenses/llhttp/LICENSE-MIT",
      "usr/share/licenses/nghttp2/COPYING",
      "usr/share/licenses/opentelemetry-proto/LICENSE",
      "usr/share/licenses/re2/LICENSE",
      "usr/share/licenses/seastar/LICENSE",
      "var/lib/dpkg/status"
    ],
    "required_dependency_records": [
      "abseil-20250512.1.json",
      "c-ares-1.34.8.json",
      "libjwt-3.6.1.json",
      "llhttp-9.4.3.json",
      "nghttp2-1.70.0.json",
      "opentelemetry-proto-1.11.0.json",
      "re2-2025-11-05.json",
      "seastar-25.05.0.json"
    ],
    "forbidden_prefixes": [
      "etc/bonvoyage",
      "home",
      "root",
      "run/secrets",
      "workspace"
    ],
    "maximum_entries": 4096,
    "maximum_uncompressed_bytes": 1073741824
  },
  "identity": {
    "source_repository": "https://github.com/routesphere-global/bonvoyage",
    "builder_repository": "ghcr.io/routesphere-global/bonvoyage-oci-builder",
    "image_repository": "ghcr.io/routesphere-global/bonvoyage",
    "product": "RouteSphere BonVoyage Dataplane",
    "vendor": "RouteSphere",
    "upstream_http1_client": "seastar-reference"
  },
  "authority": {
    "release_admitted": false,
    "publishable": false
  }
}
