{
  "schema_version": 1,
  "classification": "routesphere-bonvoyage-oss-release-identity-workflow-contract",
  "state": "candidate-intake-foundation",
  "source": {
    "repository": "https://github.com/routesphere-global/bonvoyage",
    "event": "workflow_dispatch",
    "ref_type": "tag",
    "tag_pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$",
    "protected_tag_required": true,
    "pushed_commit_required": true,
    "clean_checkout_required": true
  },
  "execution": {
    "environment": "release",
    "runner": "ubuntu-24.04",
    "workflow_permissions": {
      "contents": "read"
    },
    "job_permissions": {
      "preflight": {
        "contents": "read"
      },
      "candidate-intake": {
        "contents": "read",
        "actions": "read"
      },
      "identity-probe": {
        "contents": "read",
        "id-token": "write"
      }
    },
    "jobs": {
      "preflight": {
        "timeout_minutes": 5
      },
      "candidate-intake": {
        "timeout_minutes": 20
      },
      "identity-probe": {
        "timeout_minutes": 10
      }
    },
    "artifact_retention_days": 3,
    "maximum_billable_job_minutes": 35,
    "manual_only": true,
    "scheduled_runs": false,
    "self_hosted_runners": false,
    "cancel_in_progress": false
  },
  "actions": {
    "checkout": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
    "setup_node": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
    "download_artifact": "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333",
    "cosign_installer": "sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6",
    "upload_artifact": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9"
  },
  "candidate_intake": {
    "contract_path": "packaging/release/oss-candidate-intake-contract.json",
    "discovery_script": "scripts/discover-oss-release-candidate-runs.mjs",
    "intake_script": "scripts/intake-oss-release-candidate.mjs",
    "workflow_files": {
      "debian": ".github/workflows/oss-deb-reproducibility.yml",
      "oci": ".github/workflows/oss-oci-reproducibility.yml"
    },
    "workflow_names": {
      "debian": "OSS Debian Reproducibility Candidate",
      "oci": "OSS OCI Reproducibility Candidate"
    },
    "artifact_names": {
      "debian": [
        "oss-deb-build-a",
        "oss-deb-build-b",
        "oss-deb-comparison"
      ],
      "oci": [
        "oss-oci-build-a",
        "oss-oci-build-b",
        "oss-oci-comparison"
      ]
    },
    "download_root": "${{ runner.temp }}/release-candidate-input",
    "output_path": "${{ runner.temp }}/release-candidate-intake",
    "output_artifact": "oss-release-candidate-intake",
    "exact_source_required": true,
    "required_run_attempt": 1,
    "caller_selected_run_ids_allowed": false
  },
  "identity": {
    "issuer": "https://token.actions.githubusercontent.com",
    "subject_prefix": "https://github.com/routesphere-global/bonvoyage/.github/workflows/release.yml@refs/tags/",
    "cosign_version": "v3.1.4",
    "probe_classification": "routesphere-bonvoyage-oss-release-identity-probe",
    "probe_path": "release-identity-probe/identity-probe.json",
    "bundle_path": "release-identity-probe/identity-probe.sigstore.json",
    "verification_required": true,
    "caller_selected_payload_allowed": false
  },
  "authority": {
    "candidate_intake_allowed": true,
    "identity_probe_signature_allowed": true,
    "product_artifact_signature_allowed": false,
    "product_provenance_allowed": false,
    "release_admitted": false,
    "publishable": false,
    "github_release_created": false,
    "package_uploaded": false,
    "container_uploaded": false
  }
}
