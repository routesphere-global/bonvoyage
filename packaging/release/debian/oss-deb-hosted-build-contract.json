{
  "schema_version": 1,
  "classification": "routesphere-bonvoyage-oss-deb-hosted-build-contract",
  "activation": {
    "state": "activatable",
    "template_path": "packaging/release/debian/oss-deb-reproducibility.workflow.yml",
    "active_workflow_path": ".github/workflows/oss-deb-reproducibility.yml",
    "public_repository_created": true,
    "builder_image_identity_verified": true,
    "repository_settings_verified": true
  },
  "source": {
    "repository": "https://github.com/routesphere-global/bonvoyage",
    "event": "workflow_dispatch",
    "ref_type": "tag",
    "tag_pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$",
    "protected_tag_required": true,
    "pushed_commit_required": true,
    "clean_checkout_required": true
  },
  "execution": {
    "environment": "release",
    "runner": "ubuntu-24.04",
    "platform": "linux/amd64",
    "permissions": {
      "contents": "read"
    },
    "provenance_permissions": {
      "contents": "read",
      "id-token": "write",
      "attestations": "write"
    },
    "jobs": {
      "preflight": {
        "timeout_minutes": 5
      },
      "build-a": {
        "timeout_minutes": 90
      },
      "build-b": {
        "timeout_minutes": 90
      },
      "compare": {
        "timeout_minutes": 15
      },
      "provenance": {
        "timeout_minutes": 10
      }
    },
    "artifact_retention_days": 3,
    "maximum_billable_job_minutes": 210,
    "manual_only": true,
    "scheduled_runs": false,
    "self_hosted_runners": false,
    "cancel_in_progress": false
  },
  "builder_image": {
    "repository": "ghcr.io/routesphere-global/bonvoyage-debian-builder",
    "reference": "ghcr.io/routesphere-global/bonvoyage-debian-builder@sha256:34c900a9678853d5985cd457568a9daa6d5e8290d894279184fbdc920d913111",
    "verification_receipt": "packaging/release/debian/oss-deb-builder-image-verification.json",
    "entrypoint": "/usr/local/bin/bonvoyage-oss-deb-builder",
    "network": "none",
    "read_only_root": true
  },
  "actions": {
    "checkout": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
    "upload_artifact": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
    "download_artifact": "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333",
    "attest": "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6"
  },
  "evidence": {
    "builder_artifacts": [
      "build-receipt.json",
      "builder-execution.json",
      "builder-image-observation.json",
      "bonvoyage-gateway_*.deb"
    ],
    "comparison_artifacts": [
      "reproducibility-receipt.json",
      "hosted-reproducibility-receipt.json"
    ],
    "builder_names": [
      "oss-deb-build-a",
      "oss-deb-build-b"
    ],
    "comparison_name": "oss-deb-comparison",
    "provenance_artifacts": [
      "provenance-receipt.json",
      "provenance.sigstore.jsonl"
    ],
    "provenance_name": "oss-deb-provenance"
  },
  "provenance": {
    "recorder_script": "scripts/record-oss-hosted-provenance.mjs",
    "predicate_type": "https://slsa.dev/provenance/v1",
    "slsa_build_level": 2,
    "subject_builder": "build-a"
  },
  "authority": {
    "release_admitted": false,
    "publishable": false,
    "github_release_created": false,
    "package_uploaded": false,
    "container_uploaded": false,
    "signature_created": false,
    "provenance_created": true
  }
}
