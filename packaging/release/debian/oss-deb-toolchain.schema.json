{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.routesphere.global/bonvoyage/oss-deb-toolchain-v1.schema.json",
  "title": "RouteSphere BonVoyage OSS Debian toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "distribution",
    "architecture",
    "builder_image",
    "os_release",
    "packages",
    "tools"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "classification": {"const": "routesphere-bonvoyage-oss-deb-toolchain"},
    "distribution": {"const": "ubuntu-24.04"},
    "architecture": {"const": "amd64"},
    "builder_image": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"
    },
    "os_release": {"$ref": "#/$defs/fileIdentity"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]*(?::[a-z0-9]+)?$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "resolved_path", "bytes", "sha256"],
        "properties": {
          "name": {"enum": ["dh", "dpkg-buildpackage", "dpkg-deb", "dpkg-query", "python3"]},
          "path": {"type": "string", "pattern": "^/"},
          "resolved_path": {"type": "string", "pattern": "^/"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"const": "/etc/os-release"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
