        "package_absent",
        "service_account_absent",
        "state_absent",
        "shadow_unit_absent"
      ]
    },
    {
      "id": "installed-inactive",
      "required_checks": [
        "package_identity_exact",
        "payload_identity_exact",
        "runtime_release_identity_exact",
        "service_account_non_root",
        "state_modes_safe",
        "service_disabled",
        "service_inactive",
        "package_unit_authoritative"
      ]
    },
    {
      "id": "commissioned",
      "required_checks": [
        "snapshot_identity_exact",
        "snapshot_mode_safe",
        "service_enabled",
        "service_active",
        "effective_hardening_exact",
        "process_non_root",
        "process_binary_exact",
        "loopback_admin",
        "loopback_metrics"
      ]
    },
    {
      "id": "traffic",
      "required_checks": [
        "fixed_route_exact",
        "proxied_route_exact",
        "admin_ready",
        "metrics_accounting_exact",
        "runtime_error_counters_zero",
        "process_identity_stable",
        "automatic_restarts_zero"
      ]
    },
    {
      "id": "stopped",
      "required_checks": [
        "graceful_stop",
        "service_inactive",
        "process_absent"
      ]
    },
    {
      "id": "removed",
      "required_checks": [
        "package_absent",
        "binary_absent",
        "package_unit_absent",
        "service_account_retained",
        "snapshot_retained",
        "operator_state_retained"
      ]
