+class x509_certificate {
+public:
+    explicit x509_certificate(const gnutls_datum_t& encoded) {
+        gtls_chk(gnutls_x509_crt_init(&_certificate));
+        try {
+            gtls_chk(gnutls_x509_crt_import(
+                    _certificate, &encoded, GNUTLS_X509_FMT_DER));
+        } catch (...) {
+            gnutls_x509_crt_deinit(_certificate);
+            _certificate = nullptr;
+            throw;
+        }
+    }
+
+    x509_certificate(const x509_certificate&) = delete;
+    x509_certificate& operator=(const x509_certificate&) = delete;
+
+    ~x509_certificate() {
+        if (_certificate != nullptr) {
+            gnutls_x509_crt_deinit(_certificate);
+        }
+    }
+
+    operator gnutls_x509_crt_t() const {
+        return _certificate;
+    }
+
+private:
+    gnutls_x509_crt_t _certificate = nullptr;
+};
+
+class x509_certificate_list {
+public:
+    x509_certificate_list(const tls::blob& encoded, tls::x509_crt_format fmt) {
+        blob_wrapper data(encoded);
+        const auto result = gnutls_x509_crt_list_import2(
+                &_certificates, &_count, &data,
+                gnutls_x509_crt_fmt_t(fmt), 0);
+        if (result < 0) {
+            // gnutls_x509_crt_list_import2() releases the partially imported
+            // objects and the returned array before reporting an error.
+            _certificates = nullptr;
+            _count = 0;
+            gtls_chk(result);
+        }
+    }
+
+    x509_certificate_list(const x509_certificate_list&) = delete;
+    x509_certificate_list& operator=(const x509_certificate_list&) = delete;
+
+    ~x509_certificate_list() {
+        release();
+    }
+
+    void release() noexcept {
+        for (unsigned int i = 0; i < _count; ++i) {
+            gnutls_x509_crt_deinit(_certificates[i]);
+        }
+        gnutls_free(_certificates);
+        _certificates = nullptr;
+        _count = 0;
+    }
+
+    unsigned int size() const {
+        return _count;
+    }
+
+    gnutls_x509_crt_t operator[](unsigned int index) const {
+        return _certificates[index];
+    }
+
+private:
+    gnutls_x509_crt_t* _certificates = nullptr;
+    unsigned int _count = 0;
+};
+
+static void verify_supported_name_constraints(gnutls_x509_crt_t certificate) {
+    gnutls_x509_name_constraints_t constraints = nullptr;
+    gtls_chk(gnutls_x509_name_constraints_init(&constraints));
+    std::unique_ptr<std::remove_pointer_t<gnutls_x509_name_constraints_t>,
+            void(*)(gnutls_x509_name_constraints_t)> guard(
+            constraints, &gnutls_x509_name_constraints_deinit);
+
+    unsigned int critical = 0;
+    const auto result = gnutls_x509_crt_get_name_constraints(
+            certificate, constraints, 0, &critical);
+    if (result == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE) {
+        return;
+    }
+    if (result < 0) {
+        throw tls::verification_error(
+                "TLS certificate contains malformed name constraints");
+    }
+
+    const auto verify_entries = [constraints](auto getter) {
+        for (unsigned int index = 0;; ++index) {
+            unsigned int type = 0;
+            gnutls_datum_t name{};
+            const auto entry_result = getter(
+                    constraints, index, &type, &name);
+            if (entry_result == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE) {
+                return;
+            }
+            if (entry_result < 0) {
+                throw tls::verification_error(
+                        "TLS certificate contains malformed name constraints");
+            }
+            if (type == GNUTLS_SAN_DN || type == GNUTLS_SAN_URI) {
+                throw tls::verification_error(
+                        "TLS certificate uses unsupported directoryName or URI name constraints");
+            }
+        }
+    };
+
+    verify_entries(&gnutls_x509_name_constraints_get_permitted);
+    verify_entries(&gnutls_x509_name_constraints_get_excluded);
+}
+
+static void verify_key_usage(gnutls_x509_crt_t certificate) {
+    unsigned int usage = 0;
+    unsigned int critical = 0;
+    const auto result = gnutls_x509_crt_get_key_usage(
+            certificate, &usage, &critical);
+    if (result == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE) {
+        return;
+    }
+    if (result < 0) {
+        throw tls::verification_error(
+                "TLS certificate contains malformed keyUsage");
+    }
+    if (usage == 0) {
+        throw tls::verification_error(
+                "TLS certificate keyUsage asserts no permitted operation");
+    }
+}
+
+static bool has_dns_subject_alt_name(gnutls_x509_crt_t certificate) {
+    for (unsigned int index = 0;; ++index) {
+        size_t size = 0;
+        unsigned int critical = 0;
+        auto result = gnutls_x509_crt_get_subject_alt_name(
+                certificate, index, nullptr, &size, &critical);
+        if (result == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE) {
+            return false;
+        }
+        if (result != GNUTLS_E_SHORT_MEMORY_BUFFER) {
+            if (result < 0) {
+                throw tls::verification_error(
+                        "TLS certificate contains malformed subjectAltName");
+            }
+            if (result == GNUTLS_SAN_DNSNAME) {
+                return true;
+            }
+        }
+
+        std::vector<char> value(size);
+        result = gnutls_x509_crt_get_subject_alt_name(
+                certificate, index, value.data(), &size, &critical);
+        if (result < 0) {
+            throw tls::verification_error(
+                    "TLS certificate contains malformed subjectAltName");
+        }
+        if (result == GNUTLS_SAN_DNSNAME) {
+            return true;
+        }
+    }
+}
+
+static void verify_trust_bundle_policy(
+        const tls::blob& encoded, tls::x509_crt_format fmt) {
+    x509_certificate_list certificates(encoded, fmt);
+    for (unsigned int i = 0; i < certificates.size(); ++i) {
+        verify_supported_name_constraints(certificates[i]);
+    }
+}
