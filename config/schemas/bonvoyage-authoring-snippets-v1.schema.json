{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.routesphere.global/schemas/bonvoyage-authoring-snippets-v1.schema.json",
  "title": "RouteSphere BonVoyage configuration snippet catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "classification",
    "snippet_version",
    "contract_version",
    "compiler_version",
    "configuration_schema_version",
    "authority",
    "security_boundary",
    "sources",
    "source_document_count",
    "source_documents",
    "entry_count",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "../../../schemas/bonvoyage-authoring-snippets-v1.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "classification": {
      "const": "routesphere-bonvoyage-configuration-snippet-catalog"
    },
    "snippet_version": {
      "const": "bonvoyage.configuration-snippets.v1"
    },
    "contract_version": {
      "const": "bonvoyage.configuration-authoring.v1"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configuration_schema_version": {
      "const": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_validation",
        "snippet_scope",
        "insertion_authority",
        "validation_required_after_insertion",
        "network_access",
        "live_mutation"
      ],
      "properties": {
        "semantic_validation": {
          "const": "snapshot.Compile"
        },
        "snippet_scope": {
          "const": "reviewed-syntactic-starting-points-only"
        },
        "insertion_authority": {
          "const": "consumer"
        },
        "validation_required_after_insertion": {
          "const": true
        },
        "network_access": {
          "const": false
        },
        "live_mutation": {
          "const": false
        }
      }
    },
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline",
        "secret_values_included",
        "secret_references_may_be_included",
        "environment_secret_reads",
        "private_material_included"
      ],
      "properties": {
        "offline": {
          "const": true
        },
        "secret_values_included": {
          "const": false
        },
        "secret_references_may_be_included": {
          "const": true
        },
        "environment_secret_reads": {
          "const": false
        },
        "private_material_included": {
          "const": false
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_contract",
        "completion_metadata",
        "reviewed_source_manifest"
      ],
      "properties": {
        "authoring_contract": {
          "$ref": "#/$defs/sourceFile"
        },
        "completion_metadata": {
          "$ref": "#/$defs/sourceFile"
        },
        "reviewed_source_manifest": {
          "$ref": "#/$defs/sourceFile"
        }
      }
    },
    "source_document_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceFile"
      }
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^(?:|/(?:[^~]|~[01])*)$"
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pointer", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scalar": {
      "anyOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"}
      ]
    },
    "completionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["object", "array", "string", "integer", "number", "boolean"]
        },
        "enum_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        },
        "const_value": {
          "$ref": "#/$defs/scalar"
        },
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "min_length": {"type": "integer", "minimum": 0},
        "max_length": {"type": "integer", "minimum": 0},
        "pattern": {"type": "string"},
        "min_items": {"type": "integer", "minimum": 0},
        "max_items": {"type": "integer", "minimum": 0},
        "unique_items": {"type": "boolean"},
        "item": {
          "$ref": "#/$defs/completionValue"
        }
      }
    },
    "jsonValue": {
      "anyOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    },
    "editPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_path",
        "configuration_path",
        "title",
        "summary",
        "secret_reference",
        "value"
      ],
      "properties": {
        "payload_path": {"$ref": "#/$defs/pointer"},
        "configuration_path": {"$ref": "#/$defs/pointer"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "secret_reference": {"type": "boolean"},
        "value": {"$ref": "#/$defs/completionValue"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "category",
        "source",
        "insertion",
        "payload",
        "yaml",
        "yaml_sha256",
        "edit_points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 96
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "category": {
          "enum": ["baseline", "routing", "security", "traffic-policy", "transformation", "transport"]
        },
        "source": {"$ref": "#/$defs/sourceSelection"},
        "insertion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container_path", "mode"],
          "properties": {
            "container_path": {"$ref": "#/$defs/pointer"},
            "mode": {
              "enum": ["replace-document", "merge-object", "append-array-item"]
            }
          }
        },
        "payload": {"$ref": "#/$defs/jsonValue"},
        "yaml": {"type": "string", "minLength": 2, "maxLength": 1048576},
        "yaml_sha256": {"$ref": "#/$defs/sha256"},
        "edit_points": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/editPoint"}
        }
      }
    }
  }
}
