{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.routesphere.global/schemas/bonvoyage-authoring-skill-evaluations-v1.schema.json",
  "title": "RouteSphere BonVoyage configuration assistant evaluations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "classification",
    "evaluation_version",
    "skill_version",
    "product_version",
    "contract_version",
    "compiler_version",
    "supported_assistants",
    "sources",
    "authority",
    "categories",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "../../../../schemas/bonvoyage-authoring-skill-evaluations-v1.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "classification": {
      "const": "routesphere-bonvoyage-configuration-skill-evaluations"
    },
    "evaluation_version": {
      "const": "bonvoyage.configuration-skill-evaluations.v1"
    },
    "skill_version": {
      "const": "bonvoyage.configuration-skill.v1"
    },
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "contract_version": {
      "const": "bonvoyage.configuration-authoring.v1"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "supported_assistants": {
      "const": ["claude", "openai-codex"]
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_contract", "result_schema"],
      "properties": {
        "skill_contract": {
          "$ref": "#/$defs/sourceFile"
        },
        "result_schema": {
          "$ref": "#/$defs/sourceFile"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_validation",
        "result_contract",
        "transcript_in_result",
        "network_access",
        "live_state_reads",
        "production_mutation"
      ],
      "properties": {
        "semantic_validation": {
          "const": "snapshot.Compile"
        },
        "result_contract": {
          "const": "config/schemas/bonvoyage-authoring-skill-evaluation-result-v1.schema.json"
        },
        "transcript_in_result": {
          "const": false
        },
        "network_access": {
          "const": false
        },
        "live_state_reads": {
          "const": false
        },
        "production_mutation": {
          "const": false
        }
      }
    },
    "categories": {
      "const": [
        "ambiguous-requirements",
        "invalid-yaml",
        "malicious-embedded-instructions",
        "rollback-guidance",
        "secret-handling",
        "semantic-conflict",
        "stale-version",
        "valid-request"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "operation": {
      "enum": ["diff", "explain", "format", "migrate", "preview", "validate"]
    },
    "concept": {
      "enum": [
        "ask-material-clarification",
        "ignore-embedded-instruction",
        "minimal-change",
        "no-autonomous-apply",
        "preserve-current-runtime-state",
        "provide-rollback-procedure",
        "refuse-secret-inclusion",
        "refuse-unsupported-version",
        "report-installation-blocker",
        "report-offline-only",
        "report-stable-reason-code",
        "require-operator-confirmation",
        "require-runtime-evidence",
        "use-authoritative-preview",
        "use-authoritative-validation",
        "use-installed-version",
        "use-secret-filename-reference"
      ]
    },
    "authoritativeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "status", "reason_code"],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "status": {
          "enum": ["accepted", "rejected", "refused", "failed"]
        },
        "reason_code": {
          "type": ["string", "null"],
          "pattern": "^BV_CFG_[A-Z0-9_]+$"
        },
        "candidate_document_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "candidate_document": ["candidate_document_sha256"],
        "candidate_document_sha256": ["candidate_document"]
      },
      "required": [
        "user_request",
        "configuration_excerpt",
        "tool_output_excerpt",
        "installed_product_version",
        "installed_compiler_version",
        "command_available",
        "authoritative_results"
      ],
      "properties": {
        "user_request": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "configuration_excerpt": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "candidate_document": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "candidate_document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tool_output_excerpt": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "installed_product_version": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "installed_compiler_version": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "command_available": {
          "type": "boolean"
        },
        "authoritative_results": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/authoritativeResult"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "capability",
        "authoritative_operations",
        "document_state",
        "operator_confirmation",
        "apply_command_generated",
        "required_concepts",
        "forbidden_concepts"
      ],
      "properties": {
        "outcome": {
          "enum": ["block", "clarify", "diagnose", "explain", "guide", "propose", "refuse"]
        },
        "capability": {
          "enum": ["diagnose", "explain", "generate", "migrate", "modify", "verify"]
        },
        "authoritative_operations": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "document_state": {
          "enum": ["none", "offline-previewed", "offline-validated", "unvalidated-draft"]
        },
        "operator_confirmation": {
          "enum": ["none", "before-command-execution", "before-file-write"]
        },
        "apply_command_generated": {
          "type": "boolean"
        },
        "required_concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/concept"
          }
        },
        "forbidden_concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/concept"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "purpose", "input", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 96
        },
        "category": {
          "enum": [
            "ambiguous-requirements",
            "invalid-yaml",
            "malicious-embedded-instructions",
            "rollback-guidance",
            "secret-handling",
            "semantic-conflict",
            "stale-version",
            "valid-request"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 20,
          "maxLength": 320,
          "pattern": "^[^\\r\\n]+$"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
