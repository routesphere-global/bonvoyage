PROJECT_NAME           = "RouteSphere BonVoyage Dataplane"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"
INPUT                  = "@DOXYGEN_INPUT_DIR@"
FILE_PATTERNS          = *.hh *.cc
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
WARN_IF_UNDOCUMENTED   = YES
