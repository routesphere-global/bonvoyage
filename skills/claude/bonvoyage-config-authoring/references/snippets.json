    {
      "id": "route-api-key-auth",
      "title": "API-key admission",
      "summary": "Require a named request header whose value is checked against a deployment-secret credential file.",
      "category": "security",
      "source": {
        "path": "tests/fixtures/phase3-api-key.yaml",
        "pointer": "/virtual_hosts/0/routes/1/api_key_auth",
        "sha256": "6e400dfa5f617bd3ce8bd66bd3a31b438c95cf80c71e9fa201f89326a70ec3ca"
      },
      "insertion": {
        "container_path": "/virtual_hosts/*/routes/*",
        "mode": "merge-object"
      },
      "payload": {
        "api_key_auth": {
          "header_name": "X-API-Key",
          "credentials_secret": "phase3-api-keys.txt"
        }
      },
      "yaml": "api_key_auth:\n  header_name: X-API-Key\n  credentials_secret: phase3-api-keys.txt\n",
      "yaml_sha256": "ca158917064494d30e06b865edab8f5ae5922104c83bc59ed04cbb567b0551c4",
      "edit_points": [
        {
          "payload_path": "/api_key_auth/credentials_secret",
          "configuration_path": "/virtual_hosts/*/routes/*/api_key_auth/credentials_secret",
          "title": "API-key credentials secret",
          "summary": "The deployment-secret filename containing the accepted API-key credential set.",
          "secret_reference": true,
          "value": {
            "kind": "string",
            "min_length": 1,
            "max_length": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        {
          "payload_path": "/api_key_auth/header_name",
          "configuration_path": "/virtual_hosts/*/routes/*/api_key_auth/header_name",
          "title": "API-key header",
          "summary": "The downstream HTTP header from which the API key is read.",
          "secret_reference": false,
          "value": {
            "kind": "string",
            "min_length": 1,
            "max_length": 128,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          }
        }
      ]
    },
    {
      "id": "route-cors",
      "title": "CORS policy",
      "summary": "Add bounded browser-origin, method, header, credential and preflight-cache rules to one route.",
      "category": "security",
      "source": {
        "path": "tests/fixtures/phase3-cors.yaml",
        "pointer": "/virtual_hosts/0/routes/0/cors",
        "sha256": "a4da2371bde1da956b35faf0beb32460dbe44b848128cf454874a8e3d9af4ed9"
      },
      "insertion": {
        "container_path": "/virtual_hosts/*/routes/*",
        "mode": "merge-object"
      },
      "payload": {
        "cors": {
          "allowed_origins": [
            "https://app.example.com",
            "http://localhost:3000"
          ],
          "allowed_methods": [
            "GET"
          ],
          "allowed_headers": [
            "Authorization",
            "Content-Type",
            "X-Request-Id"
          ],
          "exposed_headers": [
            "X-Request-Id",
            "X-Trace-Id"
          ],
          "allow_credentials": true,
          "max_age_seconds": 600
        }
      },
      "yaml": "cors:\n  allowed_origins:\n    - https://app.example.com\n    - http://localhost:3000\n  allowed_methods:\n    - GET\n  allowed_headers:\n    - Authorization\n    - Content-Type\n    - X-Request-Id\n  exposed_headers:\n    - X-Request-Id\n    - X-Trace-Id\n  allow_credentials: true\n  max_age_seconds: 600\n",
      "yaml_sha256": "9ec7a07a2ebea50885f4dbdc68115a011d42836c9e58d249cd2442ff0a8ecf7c",
      "edit_points": [
        {
          "payload_path": "/cors/allow_credentials",
          "configuration_path": "/virtual_hosts/*/routes/*/cors/allow_credentials",
          "title": "Allow credentials",
          "summary": "Whether CORS responses permit downstream credentials under the configured origin policy.",
          "secret_reference": false,
          "value": {
            "kind": "boolean"
          }
        },
        {
          "payload_path": "/cors/allowed_headers",
          "configuration_path": "/virtual_hosts/*/routes/*/cors/allowed_headers",
          "title": "Allowed request headers",
          "summary": "The bounded request-header names allowed by CORS preflight handling.",
          "secret_reference": false,
          "value": {
            "kind": "array",
            "max_items": 32,
            "unique_items": true,
            "item": {
              "kind": "string",
              "min_length": 1,
              "max_length": 128,
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            }
          }
        },
        {
          "payload_path": "/cors/allowed_methods",
          "configuration_path": "/virtual_hosts/*/routes/*/cors/allowed_methods",
          "title": "Allowed CORS methods",
          "summary": "The HTTP methods allowed by this route's CORS policy.",
          "secret_reference": false,
          "value": {
            "kind": "array",
            "min_items": 1,
            "max_items": 16,
            "unique_items": true,
            "item": {
              "kind": "string",
              "min_length": 1,
              "max_length": 32,
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Z-]+$"
            }
          }
        },
        {
          "payload_path": "/cors/allowed_origins",
          "configuration_path": "/virtual_hosts/*/routes/*/cors/allowed_origins",
          "title": "Allowed origins",
          "summary": "The explicit origin values accepted when any-origin mode is disabled.",
          "secret_reference": false,
          "value": {
            "kind": "array",
            "min_items": 1,
            "max_items": 32,
            "unique_items": true,
            "item": {
              "kind": "string",
              "min_length": 8,
              "max_length": 512
            }
          }
        },
        {
          "payload_path": "/cors/exposed_headers",
          "configuration_path": "/virtual_hosts/*/routes/*/cors/exposed_headers",
          "title": "Exposed response headers",
          "summary": "The response-header names exposed to browser clients by CORS.",
          "secret_reference": false,
          "value": {
            "kind": "array",
            "max_items": 32,
            "unique_items": true,
            "item": {
              "kind": "string",
              "min_length": 1,
              "max_length": 128,
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            }
          }
        },
        {
          "payload_path": "/cors/max_age_seconds",
          "configuration_path": "/virtual_hosts/*/routes/*/cors/max_age_seconds",
          "title": "Preflight maximum age",
          "summary": "The maximum number of seconds a browser may cache a successful CORS preflight.",
          "secret_reference": false,
          "value": {
            "kind": "integer",
            "minimum": 0,
            "maximum": 86400
          }
        }
