            "kind": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        {
          "payload_path": "/downstream_tls/private_key_secret",
          "configuration_path": "/listeners/*/downstream_tls/private_key_secret",
