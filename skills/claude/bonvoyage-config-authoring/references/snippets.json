    {
      "id": "cluster-upstream-mtls",
      "title": "Upstream TLS and mTLS",
      "summary": "Add server identity verification and an optional client certificate to one upstream cluster.",
      "category": "transport",
      "source": {
        "path": "config/examples/upstream-tls.yaml",
        "pointer": "/clusters/0/upstream_tls",
        "sha256": "ed9925d1fa73f1d49e695311deb42f18934424cf496650ede1dbf42bae3ff317"
      },
      "insertion": {
        "container_path": "/clusters/*",
        "mode": "merge-object"
      },
      "payload": {
        "upstream_tls": {
          "server_name": "backend.internal.example.com",
          "trust_bundle_secret": "backend-ca.pem",
          "certificate_chain_secret": "gateway-client.pem",
          "private_key_secret": "gateway-client-key.pem"
        }
      },
      "yaml": "upstream_tls:\n  server_name: backend.internal.example.com\n  trust_bundle_secret: backend-ca.pem\n  certificate_chain_secret: gateway-client.pem\n  private_key_secret: gateway-client-key.pem\n",
      "yaml_sha256": "549719e5a15c8909914f98fc1c62a097b36dd63c0f427e2acf1a633765b19896",
      "edit_points": [
        {
          "payload_path": "/upstream_tls/certificate_chain_secret",
          "configuration_path": "/clusters/*/upstream_tls/certificate_chain_secret",
          "title": "Client certificate secret",
          "summary": "The deployment-secret filename containing the client certificate chain used for upstream mTLS.",
          "secret_reference": true,
          "value": {
            "kind": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        {
          "payload_path": "/upstream_tls/private_key_secret",
          "configuration_path": "/clusters/*/upstream_tls/private_key_secret",
          "title": "Client private-key secret",
          "summary": "The deployment-secret filename containing the private key used for upstream mTLS.",
          "secret_reference": true,
          "value": {
            "kind": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        {
          "payload_path": "/upstream_tls/server_name",
          "configuration_path": "/clusters/*/upstream_tls/server_name",
          "title": "TLS server name",
          "summary": "The expected upstream server identity used for SNI and certificate verification.",
          "secret_reference": false,
          "value": {
            "kind": "string",
            "min_length": 1,
            "max_length": 253,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
          }
        },
        {
          "payload_path": "/upstream_tls/trust_bundle_secret",
          "configuration_path": "/clusters/*/upstream_tls/trust_bundle_secret",
          "title": "Upstream trust-bundle secret",
          "summary": "The deployment-secret filename containing trusted certificate authorities for the upstream server.",
          "secret_reference": true,
          "value": {
            "kind": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      ]
    },
    {
      "id": "document-local-baseline",
      "title": "Local gateway baseline",
      "summary": "Start a complete local listener, fixed response, proxied route, upstream cluster and bounded runtime profile.",
      "category": "baseline",
      "source": {
        "path": "config/examples/local.yaml",
        "pointer": "",
        "sha256": "f8fd66340d769ee505e4135e0cabd713e338b9fc8323ba1d9c21e28ecc03e4a8"
      },
      "insertion": {
        "container_path": "",
        "mode": "replace-document"
      },
      "payload": {
        "server": {
          "node_id": "bonvoyage-local",
          "admin_addr": "127.0.0.1:9901",
          "metrics_addr": "127.0.0.1:9090"
        },
        "snapshot": {
          "schema_version": 1,
          "snapshot_id": "local-bootstrap",
          "generation": 1,
          "minimum_dataplane_version": "0.2.0"
        },
        "listeners": [
          {
            "name": "http",
            "address": "0.0.0.0",
            "port": 8080,
            "protocol": "http1",
            "virtual_hosts": [
              "default"
            ]
          }
        ],
        "virtual_hosts": [
          {
            "name": "default",
            "domains": [
              "*"
            ],
            "routes": [
              {
                "name": "local-response",
                "match": {
                  "path_exact": "/bonvoyage/ready"
                },
                "fixed_response": {
                  "status_code": 200,
                  "body": "ready\n",
                  "content_type": "text/plain"
                }
              },
              {
                "name": "default-route",
                "match": {
                  "path_prefix": "/"
                },
                "cluster": "local-upstream"
              }
            ]
          }
        ],
        "clusters": [
          {
            "name": "local-upstream",
            "load_balancing_policy": "round_robin",
            "connect_timeout_ms": 1000,
            "max_connections_per_shard": 128,
            "max_pending_requests_per_shard": 256,
            "endpoints": [
              {
                "name": "upstream-1",
                "address": "upstream",
                "port": 8081,
                "weight": 1
              }
            ]
          }
        ],
        "runtime_limits": {
          "max_downstream_connections_per_shard": 16384,
          "max_request_header_bytes": 32768,
          "max_request_body_bytes": 10485760,
          "max_upstream_response_header_bytes": 32768,
          "max_upstream_chunk_metadata_bytes": 32768,
          "request_timeout_ms": 15000,
          "downstream_idle_timeout_ms": 60000
        }
      },
      "yaml": "server:\n  node_id: bonvoyage-local\n  admin_addr: 127.0.0.1:9901\n  metrics_addr: 127.0.0.1:9090\nsnapshot:\n  schema_version: 1\n  snapshot_id: local-bootstrap\n  generation: 1\n  minimum_dataplane_version: 0.2.0\nlisteners:\n  - name: http\n    address: 0.0.0.0\n    port: 8080\n    protocol: http1\n    virtual_hosts:\n      - default\nvirtual_hosts:\n  - name: default\n    domains:\n      - '*'\n    routes:\n      - name: local-response\n        match:\n          path_exact: /bonvoyage/ready\n        fixed_response:\n          status_code: 200\n          body: |\n            ready\n          content_type: text/plain\n      - name: default-route\n        match:\n          path_prefix: /\n        cluster: local-upstream\nclusters:\n  - name: local-upstream\n    load_balancing_policy: round_robin\n    connect_timeout_ms: 1000\n    max_connections_per_shard: 128\n    max_pending_requests_per_shard: 256\n    endpoints:\n      - name: upstream-1\n        address: upstream\n        port: 8081\n        weight: 1\nruntime_limits:\n  max_downstream_connections_per_shard: 16384\n  max_request_header_bytes: 32768\n  max_request_body_bytes: 10485760\n  max_upstream_response_header_bytes: 32768\n  max_upstream_chunk_metadata_bytes: 32768\n  request_timeout_ms: 15000\n  downstream_idle_timeout_ms: 60000\n",
      "yaml_sha256": "b38444b9082bcd3bf287cc7e3a76b03c71424309900f0d14c40656aa11daea09",
      "edit_points": [
        {
          "payload_path": "/clusters/0/endpoints/0/address",
          "configuration_path": "/clusters/*/endpoints/*/address",
          "title": "Endpoint address",
          "summary": "The IP address or hostname used to connect to this upstream endpoint.",
          "secret_reference": false,
          "value": {
            "kind": "string",
            "min_length": 1
          }
        },
        {
          "payload_path": "/listeners/0/port",
          "configuration_path": "/listeners/*/port",
          "title": "Listener port",
          "summary": "The TCP port on which this listener accepts downstream connections.",
          "secret_reference": false,
          "value": {
            "kind": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        {
          "payload_path": "/server/node_id",
          "configuration_path": "/server/node_id",
          "title": "Node ID",
          "summary": "The stable identity reported by this gateway node to management and observability surfaces.",
          "secret_reference": false,
          "value": {
            "kind": "string",
            "min_length": 1
          }
        },
        {
          "payload_path": "/snapshot/snapshot_id",
          "configuration_path": "/snapshot/snapshot_id",
          "title": "Snapshot ID",
          "summary": "The stable operator-visible identifier assigned to this desired-state snapshot.",
          "secret_reference": false,
          "value": {
            "kind": "string",
            "min_length": 1
          }
        },
        {
          "payload_path": "/virtual_hosts/0/domains",
          "configuration_path": "/virtual_hosts/*/domains",
          "title": "Virtual-host domains",
          "summary": "The domain patterns matched by this virtual host.",
          "secret_reference": false,
          "value": {
            "kind": "array",
            "min_items": 1,
            "item": {
              "kind": "string",
              "min_length": 1
            }
          }
        }
      ]
    },
    {
      "id": "listener-downstream-tls",
