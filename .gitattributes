* text=auto eol=lf

*.pb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.gz binary
*.zip binary
*.tar binary
*.tgz binary

*.sh text eol=lf
*.cc text eol=lf
*.hh text eol=lf
*.proto text eol=lf
*.go text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Retained benchmark evidence is checksummed and must survive a clone without
# newline or encoding transformations, even when a captured tool emits CRLF.
benchmarks/results/** -text -eol -diff -merge
