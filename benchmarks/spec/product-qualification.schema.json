{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routesphere.local/schemas/benchmark-product-qualification.schema.json",
  "title": "BonVoyage Phase 2 comparator qualification",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "captured_at",
    "evidence_class",
    "architecture",
    "product_lock_sha256",
    "payload",
    "products",
    "passed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^phase2-products-[0-9]{8}T[0-9]{6}Z$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "evidence_class": { "enum": ["local-functional", "native-qualification"] },
    "architecture": { "enum": ["x86_64", "aarch64"] },
    "product_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": {
      "type": "object",
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": { "const": 256 },
        "sha256": {
          "const": "85e62acd750c4eb56b7b6a1d66dca5bfaac5f062608a1a893410d0288936c09a"
        }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "version_output",
          "image_manifest_digest",
          "image_id",
          "config_sha256",
          "executable_sha256",
          "config_valid",
          "ready",
          "payload_valid",
          "smoke_success_rate",
          "smoke_requests_per_second",
          "passed"
        ],
        "properties": {
          "name": { "enum": ["envoy", "nginx", "haproxy"] },
          "version": { "type": "string", "minLength": 1 },
          "version_output": { "type": "string", "minLength": 1 },
          "image_manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "image_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "executable_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "config_valid": { "type": "boolean" },
          "ready": { "type": "boolean" },
          "payload_valid": { "type": "boolean" },
          "smoke_success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "smoke_requests_per_second": { "type": "number", "exclusiveMinimum": 0 },
          "passed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "passed": { "type": "boolean" }
  },
  "additionalProperties": false
}
