{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routesphere.local/schemas/dedicated-validation-check.schema.json",
  "title": "BonVoyage dedicated exact-release validation check record",
  "type": "object",
  "required": [
    "schema_version",
    "check_id",
    "campaign_id",
    "source_commit",
    "artifact_lock",
    "validation_plan",
    "started_at",
    "completed_at",
    "artifact_platform",
    "executor",
    "command",
    "environment",
    "runtime_image",
    "remote_ref",
    "exit_code",
    "source_clean_before",
    "source_clean_after",
    "evidence",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "check_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "campaign_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "source_commit": { "$ref": "#/$defs/gitCommit" },
    "artifact_lock": { "$ref": "#/$defs/evidence" },
    "validation_plan": { "$ref": "#/$defs/evidence" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "artifact_platform": { "$ref": "#/$defs/platform" },
    "executor": { "$ref": "#/$defs/platform" },
    "command": { "$ref": "#/$defs/command" },
    "environment": {
      "type": "array",
      "items": { "$ref": "#/$defs/environment" }
    },
    "runtime_image": {
      "type": "object",
      "required": ["reference", "image_digest_before", "image_digest_after"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "image_digest_before": { "$ref": "#/$defs/imageDigest" },
        "image_digest_after": { "$ref": "#/$defs/imageDigest" }
      },
      "additionalProperties": false
    },
    "remote_ref": { "type": "string", "minLength": 1 },
    "exit_code": { "const": 0 },
    "source_clean_before": { "const": true },
    "source_clean_after": { "const": true },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "status": { "const": "pass" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitCommit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "evidence": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": ["operating_system", "architecture", "container_platform"],
      "properties": {
        "operating_system": { "const": "Ubuntu 24.04 LTS" },
        "architecture": { "const": "x86_64" },
        "container_platform": { "const": "linux/amd64" }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "const": "repository-root" }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["name", "value_sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "value_sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
