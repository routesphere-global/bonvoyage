{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routesphere.local/schemas/dedicated-environment-report.schema.json",
  "title": "BonVoyage DQ-INFRA-002 environment decision",
  "type": "object",
  "required": [
    "schema_version",
    "environment_id",
    "generated_at",
    "campaign_id",
    "mode",
    "evidence_class",
    "status",
    "measurement_authorized",
    "source_commit",
    "evidence",
    "cloud",
    "roles",
    "checks",
    "blockers",
    "warnings",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment_id": { "type": "string", "pattern": "^dq-infra-002-[a-f0-9]{16}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "campaign_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "mode": { "enum": ["rehearsal", "qualification"] },
    "evidence_class": { "enum": ["distributed-rehearsal", "native-qualification"] },
    "status": { "enum": ["accepted", "review-required", "blocked"] },
    "measurement_authorized": { "type": "boolean" },
    "source_commit": { "$ref": "#/$defs/gitCommit" },
    "evidence": {
      "type": "object",
      "required": ["topology", "preflight", "host_tune_binary", "raw_manifest"],
      "properties": {
        "topology": { "$ref": "#/$defs/reference" },
        "preflight": { "$ref": "#/$defs/reference" },
        "host_tune_binary": { "$ref": "#/$defs/reference" },
        "raw_manifest": { "$ref": "#/$defs/reference" },
        "review": { "$ref": "#/$defs/reference" }
      },
      "additionalProperties": false
    },
    "cloud": {
      "type": "object",
      "required": [
        "region",
        "availability_zone",
        "image_id",
        "records"
      ],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "availability_zone": { "type": "string", "minLength": 1 },
        "image_id": { "$ref": "#/$defs/imageId" },
        "dedicated_host_id": { "type": "string", "minLength": 1 },
        "host_state_before": { "type": "string", "minLength": 1 },
        "host_state_after": { "type": "string", "minLength": 1 },
        "records": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/reference" }
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/role" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "role": { "const": "load-generator" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "role": { "const": "gateway-target" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "role": { "const": "controlled-upstream" } }, "required": ["role"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "review": {
      "type": "object",
      "required": ["reviewer_id_sha256", "reviewed_at", "attestations_passed"],
      "properties": {
        "reviewer_id_sha256": { "$ref": "#/$defs/digest" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "attestations_passed": { "type": "integer", "const": 6 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "claim_boundary": {
      "const": "Environment suitability only; no gateway performance, capacity, production-readiness, competitive, security, or marketing claim is authorized."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "qualification" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "cloud": {
            "type": "object",
            "required": ["dedicated_host_id", "host_state_before", "host_state_after"],
            "properties": {
              "dedicated_host_id": { "type": "string", "minLength": 1 },
              "host_state_before": { "type": "string", "minLength": 1 },
              "host_state_after": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "required": ["review"],
        "properties": {
          "review": {
            "type": "object",
            "required": ["reviewer_id_sha256", "reviewed_at", "attestations_passed"],
            "properties": {
              "reviewer_id_sha256": { "$ref": "#/$defs/digest" },
              "reviewed_at": { "type": "string", "format": "date-time" },
              "attestations_passed": { "type": "integer", "const": 6 }
            },
            "additionalProperties": false
          },
          "measurement_authorized": { "const": true },
          "blockers": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "review-required" } }, "required": ["status"] },
      "then": {
        "properties": {
          "measurement_authorized": { "const": false },
          "blockers": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": {
        "properties": {
          "measurement_authorized": { "const": false },
          "blockers": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "imageId": { "type": "string", "pattern": "^ami-[a-f0-9]{8,32}$" },
    "reference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["id", "status", "message"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "status": { "enum": ["pass", "warn", "block"] },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": ["physical_cores", "gateway_cpuset", "reference"],
      "properties": {
        "physical_cores": { "type": "integer", "minimum": 1 },
        "gateway_cpuset": { "type": "string", "minLength": 1 },
        "reference": { "$ref": "#/$defs/reference" }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": [
        "role",
        "instance_id",
        "image_id",
        "private_ipv4",
        "availability_zone",
        "tenancy",
        "instance_type",
        "cloud_state",
        "host_fingerprint_sha256",
        "boot_id",
        "operating_system",
        "architecture",
        "kernel_release",
        "logical_cpu_count",
        "physical_core_count",
        "numa_node_count",
        "memory_total_bytes",
        "cgroup_version",
        "swap_total_bytes",
        "network",
        "observation",
        "inventory",
        "tuning_plans"
      ],
      "properties": {
        "role": { "enum": ["load-generator", "gateway-target", "controlled-upstream"] },
        "instance_id": { "type": "string", "minLength": 1 },
        "image_id": { "$ref": "#/$defs/imageId" },
        "private_ipv4": { "type": "string", "format": "ipv4" },
        "availability_zone": { "type": "string", "minLength": 1 },
        "tenancy": { "enum": ["default", "host"] },
        "host_id": { "type": "string", "minLength": 1 },
        "instance_type": { "type": "string", "minLength": 1 },
        "cloud_state": { "type": "string", "minLength": 1 },
        "host_fingerprint_sha256": { "$ref": "#/$defs/digest" },
        "boot_id": { "type": "string", "minLength": 1 },
        "operating_system": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "kernel_release": { "type": "string", "minLength": 1 },
        "logical_cpu_count": { "type": "integer", "minimum": 1 },
        "physical_core_count": { "type": "integer", "minimum": 1 },
        "numa_node_count": { "type": "integer", "minimum": 1 },
        "memory_total_bytes": { "type": "integer", "minimum": 1 },
        "cgroup_version": { "type": "integer", "minimum": 1 },
        "swap_total_bytes": { "type": "integer", "minimum": 0 },
        "network": {
          "type": "object",
          "required": [
            "interface",
            "driver",
            "pci_bus_address",
            "numa_node",
            "mtu",
            "link_speed_mbps",
            "rx_queue_count",
            "tx_queue_count",
            "irq_count",
            "hardware_rss_inventory_passed"
          ],
          "properties": {
            "interface": { "type": "string", "minLength": 1 },
            "driver": { "type": "string", "minLength": 1 },
            "pci_bus_address": { "type": "string", "minLength": 1 },
            "numa_node": { "type": "integer", "minimum": 0 },
            "mtu": { "type": "integer", "minimum": 576 },
            "link_speed_mbps": { "type": "integer", "minimum": 0 },
            "rx_queue_count": { "type": "integer", "minimum": 1 },
            "tx_queue_count": { "type": "integer", "minimum": 1 },
            "irq_count": { "type": "integer", "minimum": 1 },
            "hardware_rss_inventory_passed": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "observation": {
          "type": "object",
          "required": [
            "duration_seconds",
            "steal_percent",
            "network_error_delta",
            "clock_synchronized_before",
            "clock_synchronized_after"
          ],
          "properties": {
            "duration_seconds": { "type": "number", "minimum": 0 },
            "steal_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "network_error_delta": { "type": "integer", "minimum": 0 },
            "clock_synchronized_before": { "type": "boolean" },
            "clock_synchronized_after": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "inventory": { "$ref": "#/$defs/reference" },
        "tuning_plans": {
          "type": "array",
          "items": { "$ref": "#/$defs/plan" }
        }
      },
      "additionalProperties": false
    }
  }
}
